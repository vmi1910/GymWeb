@model GymWeb.ViewModels.ResetPasswordOtpViewModel
@{
    ViewData["Title"] = "Xác nhận OTP & đặt lại mật khẩu";
}

<section class="position-relative d-flex align-items-center justify-content-center"
         style="min-height: 90vh; background: url('https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?q=80&amp;w=1470&amp;auto=format&amp;fit=crop') no-repeat center center/cover;">

    <div class="position-absolute top-0 start-0 w-100 h-100" style="background-color: rgba(0,0,0,0.78);"></div>

    <div class="container position-relative z-index-1 my-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-5">
                <div class="card bg-dark text-white border-danger shadow-lg rounded-4 overflow-hidden">
                    <div class="card-header border-danger text-center py-4 bg-transparent">
                        <div class="mb-2" style="font-size: 2rem; color: var(--brand-red);"><i class="bi bi-envelope-check"></i></div>
                        <h3 class="fw-bold text-brand-red mb-0 brand-font">XÁC NHẬN OTP</h3>
                        <p class="text-muted small mb-0 mt-1">Nhập mã OTP đã gửi tới email và tạo mật khẩu mới</p>
                    </div>

                    <div class="card-body p-4 p-md-5">

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2">
                                <div asp-validation-summary="All" class="text-danger small mb-0"></div>
                            </div>
                        }

                        <form asp-controller="Account" asp-action="ResetPassword" method="post">
                            <input type="hidden" asp-for="Username" />

                            <div class="mb-2 text-center">
                                <span class="badge rounded-pill bg-secondary bg-opacity-25 border border-secondary px-3 py-2">
                                    <i class="bi bi-person-fill me-1"></i> @Model.Username
                                </span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Otp" class="form-label text-light small fw-bold d-block text-center">MÃ OTP (6 SỐ)</label>
                                <input asp-for="Otp" maxlength="6" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code"
                                       class="form-control bg-dark text-white border-secondary py-3 text-center fw-bold"
                                       style="font-size: 1.8rem; letter-spacing: 12px;" placeholder="------" autofocus>
                                <span asp-validation-for="Otp" class="text-danger small"></span>
                                <div class="text-center mt-2">
                                    <span class="small text-muted">Mã hết hạn sau <span id="otpCountdown" class="fw-bold text-brand-red">05:00</span></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewPassword" class="form-label text-light small fw-bold">MẬT KHẨU MỚI</label>
                                <input asp-for="NewPassword" type="password" class="form-control bg-dark text-white border-secondary py-2" placeholder="Tối thiểu 6 ký tự">
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="form-label text-light small fw-bold">NHẬP LẠI MẬT KHẨU MỚI</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control bg-dark text-white border-secondary py-2" placeholder="Xác nhận mật khẩu mới">
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-brand btn-lg rounded-pill shadow-sm">
                                    <i class="bi bi-check-circle-fill me-2"></i>ĐẶT LẠI MẬT KHẨU
                                </button>
                            </div>
                        </form>

                        <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="mt-3 text-center">
                            <input type="hidden" name="Username" value="@Model.Username" />
                            <button type="submit" class="btn btn-link text-secondary text-decoration-none small p-0">
                                <i class="bi bi-arrow-repeat me-1"></i> Chưa nhận được mã? Gửi lại OTP
                            </button>
                        </form>

                        <div class="text-center mt-4">
                            <a asp-controller="Account" asp-action="Login" class="text-muted text-decoration-none small">
                                <i class="bi bi-arrow-left me-1"></i> Quay về đăng nhập
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var el = document.getElementById('otpCountdown');
            if (!el) return;
            var remaining = 5 * 60;
            var timer = setInterval(function () {
                remaining--;
                if (remaining <= 0) {
                    clearInterval(timer);
                    el.textContent = "00:00";
                    el.classList.add("text-danger");
                    el.insertAdjacentHTML('afterend', ' <span class="text-danger">(mã có thể đã hết hạn, hãy gửi lại)</span>');
                    return;
                }
                var m = Math.floor(remaining / 60).toString().padStart(2, '0');
                var s = (remaining % 60).toString().padStart(2, '0');
                el.textContent = m + ":" + s;
            }, 1000);
        })();
    </script>
}

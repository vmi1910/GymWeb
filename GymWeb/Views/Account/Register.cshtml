@{
    ViewData["Title"] = "Đăng ký tài khoản mới";
}

<section class="position-relative d-flex align-items-center justify-content-center" 
         style="min-height: 90vh; background: url('https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=1470&auto=format&fit=crop') no-repeat center center/cover;">
    
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background-color: rgba(0,0,0,0.75);"></div>

    <div class="container position-relative z-index-1 my-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-10 col-lg-6">
                <div class="card bg-dark text-white border-danger shadow-lg rounded-4 overflow-hidden">
                    <div class="card-header border-danger text-center py-4 bg-transparent">
                        <h3 class="fw-bold text-danger mb-0">THÀNH VIÊN MỚI</h3>
                        <p class="text-muted small mb-0 mt-1">Đăng ký tài khoản để nhận ưu đãi tập luyện</p>
                    </div>
                    
                    <div class="card-body p-4 p-md-5">
                        <form action="#" method="post">
                            
                            <div class="mb-3">
                                <label for="fullname" class="form-label text-light small fw-bold">HỌ VÀ TÊN</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary py-2" id="fullname" placeholder="Nhập đầy đủ họ và tên" required>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="phone" class="form-label text-light small fw-bold">SỐ ĐIỆN THOẠI</label>
                                    <input type="tel" class="form-control bg-dark text-white border-secondary py-2" id="phone" placeholder="Số điện thoại" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="email" class="form-label text-light small fw-bold">EMAIL</label>
                                    <input type="email" class="form-control bg-dark text-white border-secondary py-2" id="email" placeholder="Địa chỉ email" required>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="reg-username" class="form-label text-light small fw-bold">TÊN ĐĂNG NHẬP (TÀI KHOẢN)</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary py-2" id="reg-username" placeholder="Tạo tên tài khoản đăng nhập" required>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="reg-password" class="form-label text-light small fw-bold">MẬT KHẨU</label>
                                    <input type="password" class="form-control bg-dark text-white border-secondary py-2" id="reg-password" placeholder="Nhập mật khẩu" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="confirm-password" class="form-label text-light small fw-bold">NHẬP LẠI MẬT KHẨU</label>
                                    <input type="password" class="form-control bg-dark text-white border-secondary py-2" id="confirm-password" placeholder="Xác nhận mật khẩu" required>
                                </div>
                            </div>

                            <div class="form-check mb-4 mt-2">
                                <input type="checkbox" class="form-check-input border-secondary bg-dark" id="agreeTerms" required>
                                <label class="form-check-label text-muted small" for="agreeTerms">Tôi đồng ý với các điều khoản sử dụng và chính sách bảo mật của phòng GYM.</label>
                            </div>
                            
                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-danger btn-lg fw-bold rounded-pill shadow-sm">ĐĂNG KÝ NGAY</button>
                            </div>

                            <div class="text-center mt-4">
                                <p class="text-muted small mb-0">Bạn đã có tài khoản? <a asp-controller="Account" asp-action="Login" class="text-danger text-decoration-none fw-bold">Đăng nhập tại đây</a></p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
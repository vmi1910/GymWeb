@model IEnumerable<GymWeb.Models.Account>
@{
    ViewData["Title"] = "Quản lý tài khoản";
    Layout = "_AdminLayout"; // Chỉ định sử dụng Layout Admin riêng biệt
}

<div class="admin-card p-4 shadow">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">DANH SÁCH TÀI KHOẢN</h3>
            <p class="text-muted small mb-0">Quản lý phân quyền và thông tin đăng nhập hệ thống</p>
        </div>
        <a asp-controller="Admin" asp-action="Create" class="btn btn-danger fw-bold px-4 rounded-pill">
            <i class="bi bi-plus-circle me-2"></i> Thêm tài khoản mới
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0" style="border-color: #222222;">
            <thead>
                <tr class="text-secondary small text-uppercase">
                    <th style="width: 10%">ID</th>
                    <th style="width: 40%">Tên Đăng Nhập (Username)</th>
                    <th style="width: 25%">Vai Trò (Role)</th>
                    <th style="width: 25%" class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-muted">#@item.AccountID</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <i class="bi bi-person-badge text-danger me-3 fs-4"></i>
                                <span class="fw-bold">@item.Username</span>
                            </div>
                        </td>
                        <td>
                            @if (item.Role == "Admin")
                            {
                                <span class="badge bg-danger text-uppercase px-3 py-2">Quản trị viên</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary text-uppercase px-3 py-2">Hội viên</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-outline-warning btn-sm me-2 rounded-pill px-3">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </button>
                            <form asp-controller="Admin" asp-action="Delete" asp-route-id="@item.AccountID" method="post">
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" 
                                onclick="return confirm('Bạn chắc chắn muốn xóa tài khoản @item.Username?');">
                                    <i class="bi bi-trash3-fill"></i> Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
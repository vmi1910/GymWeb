@model IEnumerable<GymWeb.Models.StaffSchedule>
@{
    ViewData["Title"] = "Lịch làm việc của tôi";
    Layout = "_AdminLayout";
    var staff = (GymWeb.Models.Staff)ViewBag.Staff;
    var roomNames = (Dictionary<int, string>)ViewBag.RoomNames;
}

<div class="admin-card p-4 shadow">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div><h3 class="fw-bold mb-1">LỊCH LÀM VIỆC CỦA TÔI</h3><p class="text-muted small mb-0">@staff.FullName · @staff.Role</p></div>
        <a asp-action="Register" class="btn btn-brand rounded-pill px-4 fw-bold"><i class="bi bi-calendar2-plus me-2"></i>Đăng ký ca</a>
    </div>
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0" style="border-color:#222;">
            <thead><tr class="text-secondary small text-uppercase"><th>Ngày</th><th>Phòng tập</th><th>Ca làm việc</th></tr></thead>
            <tbody>
            @if (!Model.Any()) { <tr><td colspan="3" class="text-center text-muted py-4">Bạn chưa có ca làm việc nào.</td></tr> }
            @foreach (var item in Model)
            {
                <tr><td class="fw-semibold">@item.ShiftDate.ToString("dddd, dd/MM/yyyy")</td><td>@roomNames.GetValueOrDefault(item.RoomID, "—")</td><td><span class="badge bg-danger">@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</span></td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

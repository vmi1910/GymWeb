@model GymWeb.ViewModels.ScheduleRegistrationViewModel
@{
    ViewData["Title"] = "Đăng ký ca làm việc";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-7">
        <div class="admin-card p-4 shadow mt-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="text-brand-red fw-bold mb-1"><i class="bi bi-calendar2-plus me-2"></i>ĐĂNG KÝ CA LÀM VIỆC</h4>
                    <p class="text-muted small mb-0">Chọn khung giờ còn trống để chủ động đăng ký lịch của bạn.</p>
                </div>
                <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2"><div asp-validation-summary="All" class="small mb-0"></div></div>
            }

            <form asp-action="Register" method="post">
                <div class="mb-3">
                    <label asp-for="RoomID" class="form-label text-muted small fw-bold">PHÒNG TẬP *</label>
                    <select asp-for="RoomID" asp-items="ViewBag.RoomList" class="form-select bg-dark text-white border-secondary">
                        <option value="">-- Chọn phòng --</option>
                    </select>
                </div>
                <div class="row mb-4">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label asp-for="ShiftDate" class="form-label text-muted small fw-bold">NGÀY *</label>
                        <input asp-for="ShiftDate" type="date" class="form-control bg-dark text-white border-secondary" />
                    </div>
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label asp-for="StartTime" class="form-label text-muted small fw-bold">GIỜ BẮT ĐẦU *</label>
                        <input asp-for="StartTime" type="time" class="form-control bg-dark text-white border-secondary" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EndTime" class="form-label text-muted small fw-bold">GIỜ KẾT THÚC *</label>
                        <input asp-for="EndTime" type="time" class="form-control bg-dark text-white border-secondary" />
                    </div>
                </div>
                <div class="alert alert-secondary bg-dark border-secondary text-muted small">
                    <i class="bi bi-shield-check me-2 text-brand-red"></i>Hệ thống tự kiểm tra lịch trùng của bạn và các ca đã có trong cùng phòng.
                </div>
                <div class="d-flex justify-content-end pt-3 border-top border-secondary">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 me-3">Hủy</a>
                    <button type="submit" class="btn btn-brand rounded-pill px-4 fw-bold"><i class="bi bi-calendar-check me-2"></i>Đăng ký ca</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

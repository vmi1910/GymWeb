@model IEnumerable<GymWeb.ViewModels.TrainerViewModel>
@{
    ViewData["Title"] = "Quản lý huấn luyện viên";
    Layout = "_AdminLayout";
    var list = Model.ToList();
}

<div class="admin-card p-4 shadow">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-1">DANH SÁCH HUẤN LUYỆN VIÊN</h3>
            <p class="text-muted small mb-0">Tổng số: @list.Count huấn luyện viên.</p>
        </div>
        <div class="d-flex gap-2">
            <form method="get" class="d-flex" style="max-width: 320px;">
                <input type="text" name="search" value="@ViewData["Search"]" class="form-control bg-dark text-white border-secondary me-2" placeholder="Tìm tên, chuyên môn...">
                <button type="submit" class="btn btn-outline-brand"><i class="bi bi-search"></i></button>
            </form>
            <a asp-controller="Admin" asp-action="Create" asp-route-role="Trainer" class="btn btn-brand rounded-pill px-3 text-nowrap"><i class="bi bi-person-plus-fill me-1"></i> Tạo tài khoản</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0" style="border-color: #222222;">
            <thead>
                <tr class="text-secondary small text-uppercase">
                    <th>Ảnh</th>
                    <th>Họ và tên</th>
                    <th>Số điện thoại</th>
                    <th>Chuyên môn</th>
                    <th>Chứng chỉ</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!list.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Chưa có huấn luyện viên nào.</td></tr>
                }
                @foreach (var item in list)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.CertificateImagePath))
                            {
                                <img src="@item.CertificateImagePath" alt="Chứng chỉ" class="rounded-circle border border-secondary" style="width:42px;height:42px;object-fit:cover;">
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width:42px;height:42px;">
                                    <i class="bi bi-award text-white-50"></i>
                                </div>
                            }
                        </td>
                        <td class="fw-bold">@item.FullName</td>
                        <td>@item.PhoneNumber</td>
                        <td>@(string.IsNullOrEmpty(item.Specialty) ? "-" : item.Specialty)</td>
                        <td>@(string.IsNullOrEmpty(item.Certification) ? "-" : item.Certification)</td>
                        <td>
                            @if (item.Status == "Active")
                            {
                                <span class="badge bg-success">Đang làm việc</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.Status</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.StaffID" class="btn btn-outline-warning btn-sm me-2 rounded-pill px-3">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.StaffID" method="post" class="d-inline"
                                  data-confirm-title="Xóa huấn luyện viên" data-confirm="Xóa huấn luyện viên @item.FullName? Hành động này không thể hoàn tác.">
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                    <i class="bi bi-trash3-fill"></i> Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

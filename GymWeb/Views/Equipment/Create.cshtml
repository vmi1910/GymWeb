@model GymWeb.Models.Equipment
@{
    ViewData["Title"] = "Thêm thiết bị";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="admin-card p-4 shadow mt-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="text-brand-red fw-bold mb-0"><i class="bi bi-tools me-2"></i> THÊM THIẾT BỊ</h4>
                <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2"><div asp-validation-summary="All" class="small mb-0"></div></div>
            }

            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">TÊN THIẾT BỊ *</label>
                    <input asp-for="EquipmentName" class="form-control bg-dark text-white border-secondary" required placeholder="VD: Máy chạy bộ Technogym">
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">LOẠI THIẾT BỊ</label>
                        <input asp-for="Category" class="form-control bg-dark text-white border-secondary" placeholder="VD: Cardio, Tạ, Máy tập cơ...">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">PHÒNG ĐẶT THIẾT BỊ *</label>
                        <select asp-for="RoomID" asp-items="ViewBag.RoomList" class="form-select bg-dark text-white border-secondary">
                            <option value="">-- Chọn phòng --</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">NGÀY MUA</label>
                        <input asp-for="PurchaseDate" type="date" class="form-control bg-dark text-white border-secondary">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">TÌNH TRẠNG</label>
                        <select asp-for="Status" class="form-select bg-dark text-white border-secondary">
                            <option value="Đang sử dụng">Đang sử dụng</option>
                            <option value="Bảo trì">Bảo trì</option>
                            <option value="Hỏng - ngừng sử dụng">Hỏng - ngừng sử dụng</option>
                        </select>
                    </div>
                </div>
                <div class="d-flex justify-content-end pt-3 border-top border-secondary">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 me-3">Hủy bỏ</a>
                    <button type="submit" class="btn btn-brand rounded-pill px-4 fw-bold"><i class="bi bi-floppy-fill me-2"></i> Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

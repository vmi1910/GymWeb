@model IEnumerable<GymWeb.Models.MembershipPackage>
@{
    ViewData["Title"] = "Gói tập";
    var list = Model.Where(m => m.IsActive).OrderBy(m => m.Price).ToList();
    int? currentPackageId = ViewBag.CurrentPackageId;
    DateTime? currentEndDate = ViewBag.CurrentEndDate;

    string IconFor(int durationDays) => durationDays switch
    {
        <= 31 => "bi-calendar3",
        <= 190 => "bi-star-fill",
        _ => "bi-trophy-fill"
    };
}

<section class="static-page-hero py-5">
    <div class="container text-center text-white py-4">
        <span class="section-eyebrow">Tài khoản của tôi</span>
        <h1 class="section-title mb-0">Đăng ký / Gia hạn gói tập</h1>
    </div>
</section>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <ul class="nav nav-pills mb-4 gap-2">
                <li class="nav-item"><a class="nav-link text-dark" asp-action="Index">Thông tin cá nhân</a></li>
                <li class="nav-item"><a class="nav-link active" style="background-color:var(--brand-red);" asp-action="Packages">Gói tập</a></li>
                <li class="nav-item"><a class="nav-link text-dark" asp-action="History">Lịch sử thanh toán</a></li>
                <li class="nav-item"><a class="nav-link text-dark" asp-action="Schedule">Lịch tập</a></li>
            </ul>

            @if (!list.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-card-list display-6 d-block mb-3 opacity-50"></i>
                    Hiện chưa có gói tập nào đang mở bán, vui lòng quay lại sau.
                </div>
            }
            else
            {
                <div class="package-grid">
                    @foreach (var item in list)
                    {
                        var isCurrent = currentPackageId.HasValue && currentPackageId.Value == item.PackageID;
                        var pricePerDay = item.DurationDays > 0 ? item.Price / item.DurationDays : 0;

                        <div class="pricing-card @(item.IsFeatured ? "featured" : "") @(isCurrent ? "is-current" : "")">

                            @if (isCurrent)
                            {
                                <span class="pricing-badge current-badge"><i class="bi bi-check-circle-fill me-1"></i>Đang sử dụng</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(item.BadgeText))
                            {
                                <span class="pricing-badge">@item.BadgeText</span>
                            }

                            <div class="package-thumb">
                                <i class="bi @IconFor(item.DurationDays)"></i>
                            </div>

                            <div class="pricing-header">
                                <span class="duration-tag">@item.DurationDays ngày</span>
                                <h3 class="package-name">@item.PackageName</h3>
                                <div class="price">
                                    @item.Price.ToString("N0")<span> đ / gói</span>
                                </div>
                                <div class="price-per-day">
                                    Chỉ ~<b>@pricePerDay.ToString("N0") đ</b> / ngày
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <p class="package-desc">@item.Description</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.Highlights))
                            {
                                <ul class="pricing-features">
                                    @foreach (var line in item.Highlights.Split(';', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <li><span class="check-icon">✓</span> @line.Trim()</li>
                                    }
                                </ul>
                            }

                            <button type="button" class="btn-register mt-auto" data-bs-toggle="modal" data-bs-target="#paymentMethodModal"
                                    data-package-id="@item.PackageID" data-package-name="@item.PackageName" data-package-price="@item.Price.ToString("N0")">
                                @if (isCurrent)
                                {
                                    <span><i class="bi bi-arrow-repeat me-1"></i>Gia hạn thêm</span>
                                }
                                else
                                {
                                    <span>Đăng ký ngay</span>
                                }
                            </button>
                        </div>
                    }
                </div>
            }

            @if (currentPackageId.HasValue && currentEndDate.HasValue)
            {
                <p class="text-center text-muted small mt-5 mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Gói hiện tại của bạn có hiệu lực đến <b class="text-white">@currentEndDate.Value.ToString("dd/MM/yyyy")</b>. Đăng ký thêm sẽ tự động cộng dồn thời hạn.
                </p>
            }
        </div>
    </div>
</div>

<partial name="_PaymentMethodModal" />

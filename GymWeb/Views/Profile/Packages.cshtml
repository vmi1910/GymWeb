@model IEnumerable<GymWeb.Models.MembershipPackage>
@{
    ViewData["Title"] = "Gói tập";
    var list = Model.ToList();
}

<section class="static-page-hero py-5">
    <div class="container text-center text-white py-4">
        <span class="section-eyebrow">Tài khoản của tôi</span>
        <h1 class="section-title mb-0">Đăng ký / Gia hạn gói tập</h1>
    </div>
</section>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success py-2 small">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger py-2 small">@TempData["Error"]</div>
            }

            <ul class="nav nav-pills mb-4 gap-2">
                <li class="nav-item"><a class="nav-link text-dark" asp-action="Index">Thông tin cá nhân</a></li>
                <li class="nav-item"><a class="nav-link active" style="background-color:var(--brand-red);" asp-action="Packages">Gói tập</a></li>
                <li class="nav-item"><a class="nav-link text-dark" asp-action="History">Lịch sử thanh toán</a></li>
                <li class="nav-item"><a class="nav-link text-dark" asp-action="Schedule">Lịch tập</a></li>
            </ul>

            @if (!list.Any())
            {
                <p class="text-muted">Hiện chưa có gói tập nào đang mở bán.</p>
            }

            <div class="row g-4">
                @foreach (var item in list)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="static-page-card border p-4 h-100 d-flex flex-column">
                            <h5 class="fw-bold">@item.PackageName</h5>
                            <p class="text-muted small mb-2">@item.DurationDays ngày sử dụng</p>
                            <h3 class="text-brand-red fw-bold mb-3">@item.Price.ToString("N0") đ</h3>
                            <p class="small text-muted flex-grow-1">@item.Description</p>
                            <form asp-action="Register" method="post">
                                <input type="hidden" name="packageId" value="@item.PackageID" />
                                <button type="submit" class="btn btn-brand w-100 rounded-pill fw-bold"
                                        onclick="return confirm('Xác nhận đăng ký gói này?');">
                                    Đăng ký ngay
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

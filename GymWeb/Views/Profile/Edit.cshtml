@model GymWeb.Models.Member
@{
    ViewData["Title"] = "Chỉnh sửa thông tin cá nhân";
}

<section class="static-page-hero py-5">
    <div class="container text-center text-white py-4">
        <span class="section-eyebrow">Tài khoản của tôi</span>
        <h1 class="section-title mb-0">Chỉnh sửa thông tin</h1>
    </div>
</section>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="static-page-card border p-4 p-md-5">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2">
                        <div asp-validation-summary="All" class="small mb-0"></div>
                    </div>
                }

                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="MemberID" />
                    <input type="hidden" asp-for="AccountID" />
                    <input type="hidden" asp-for="RegisterDate" />
                    <input type="hidden" asp-for="Status" />

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">HỌ VÀ TÊN *</label>
                        <input asp-for="FullName" class="form-control" required>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">NGÀY SINH</label>
                            <input type="date" name="DateOfBirth" id="DateOfBirth" class="form-control" value="@(Model.DateOfBirth == default ? "" : Model.DateOfBirth.ToString("yyyy-MM-dd"))">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">GIỚI TÍNH</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">SỐ ĐIỆN THOẠI</label>
                            <input asp-for="PhoneNumber" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">EMAIL</label>
                            <input asp-for="Email" type="email" class="form-control">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">ĐỊA CHỈ</label>
                        <input asp-for="Address" class="form-control">
                    </div>

                    <div class="d-flex justify-content-end pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 me-3">Hủy bỏ</a>
                        <button type="submit" class="btn btn-brand rounded-pill px-4 fw-bold">
                            <i class="bi bi-floppy-fill me-2"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

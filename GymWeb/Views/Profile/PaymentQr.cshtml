@model GymWeb.Models.Payment
@{
    ViewData["Title"] = "Thanh toán chuyển khoản";
    Layout = "_Layout";
    var package = ViewBag.Package as GymWeb.Models.MembershipPackage;
    var qrPayload = $"NGAN HANG: GYM FITNESS BANK | STK: 0899 123 456 | CHU TK: CONG TY GYM FITNESS | SO TIEN: {Model.Amount:0} | NOI DUNG: GYM HD{Model.PaymentID}";
    var qrUrl = "https://api.qrserver.com/v1/create-qr-code/?size=260x260&data=" + Uri.EscapeDataString(qrPayload);
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="static-page-card border p-4 p-md-5 text-center">
                    <span class="section-eyebrow">Chuyển khoản ngân hàng</span>
                    <h3 class="fw-bold mb-3">QUÉT MÃ ĐỂ THANH TOÁN</h3>

                    <div class="d-inline-block p-3 mb-3" style="background: #fff; border-radius: var(--radius-md);">
                        <img src="@qrUrl" alt="QR thanh toán" width="220" height="220" />
                    </div>

                    <div class="surface-card p-3 mb-4 text-start">
                        <div class="d-flex justify-content-between small py-1">
                            <span class="text-muted">Ngân hàng</span>
                            <span class="fw-bold">GYM FITNESS BANK</span>
                        </div>
                        <div class="d-flex justify-content-between small py-1">
                            <span class="text-muted">Số tài khoản</span>
                            <span class="fw-bold">0899 123 456</span>
                        </div>
                        <div class="d-flex justify-content-between small py-1">
                            <span class="text-muted">Chủ tài khoản</span>
                            <span class="fw-bold">CONG TY GYM FITNESS</span>
                        </div>
                        <div class="d-flex justify-content-between small py-1">
                            <span class="text-muted">Số tiền</span>
                            <span class="fw-bold text-brand-red">@Model.Amount.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between small py-1">
                            <span class="text-muted">Nội dung</span>
                            <span class="fw-bold">GYM HD@(Model.PaymentID)</span>
                        </div>
                    </div>

                    <p class="text-muted small mb-4">
                        <i class="bi bi-info-circle me-1"></i>Đây là mã QR mô phỏng cho mục đích đồ án, không kết nối cổng thanh toán ngân hàng thật.
                        Sau khi "chuyển khoản", bấm nút bên dưới để xác nhận.
                    </p>

                    <form asp-action="ConfirmTransferPaid" asp-route-id="@Model.PaymentID" method="post"
                          data-confirm-title="Xác nhận đã chuyển khoản"
                          data-confirm="Xác nhận bạn đã chuyển khoản @Model.Amount.ToString("N0") đ thành công?">
                        <button type="submit" class="btn btn-brand btn-lg rounded-pill px-5 w-100">
                            <i class="bi bi-check-circle-fill me-2"></i>Tôi đã thanh toán
                        </button>
                    </form>

                    <a asp-action="History" class="d-block mt-3 text-muted small text-decoration-none">Để sau, xem lịch sử thanh toán</a>
                </div>
            </div>
        </div>
    </div>
</section>

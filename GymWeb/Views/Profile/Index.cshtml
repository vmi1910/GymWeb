@model GymWeb.Models.Member
@{
    ViewData["Title"] = "Thông tin cá nhân";
    var currentPackage = ViewBag.CurrentPackage as GymWeb.Models.MembershipPackage;
    var currentSubscription = ViewBag.CurrentSubscription as GymWeb.Models.Subscription;
    bool isActive = ViewBag.IsActive;
}

<section class="static-page-hero py-5">
    <div class="container text-center text-white py-4">
        <span class="section-eyebrow">Tài khoản của tôi</span>
        <h1 class="section-title mb-0">Xin chào, @Model.FullName</h1>
    </div>
</section>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success py-2 small">@TempData["Success"]</div>
            }

                <div class="card bg-dark text-white border-danger shadow-lg rounded-4 overflow-hidden">
                    <div class="card-body p-4 p-md-5">

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2">
                                <div asp-validation-summary="All" class="small mb-0"></div>
                            </div>
                        }

                        <div class="row mb-4 gy-2">
                            <div class="col-md-4">
                                <span class="text-muted small d-block">Tên đăng nhập</span>
                                <span class="fw-bold">@Model.Username</span>
                            </div>
                            <div class="col-md-4">
                                <span class="text-muted small d-block">Ngày đăng ký</span>
                                <span class="fw-bold">@Model.RegisterDate.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="col-md-4">
                                <span class="text-muted small d-block">Trạng thái</span>
                                @if (Model.Status == "Active")
                                {
                                    <span class="badge bg-success">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@Model.Status</span>
                                }
                            </div>
                        </div>

                        <form asp-controller="Profile" asp-action="Index" method="post">

                            <h6 class="text-white border-bottom border-secondary pb-2 mb-3">THÔNG TIN CÁ NHÂN</h6>

                            <div class="mb-3">
                                <label asp-for="FullName" class="form-label text-light small fw-bold">HỌ VÀ TÊN *</label>
                                <input asp-for="FullName" class="form-control bg-dark text-white border-secondary">
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label asp-for="DateOfBirth" class="form-label text-light small fw-bold">NGÀY SINH</label>
                                    <input asp-for="DateOfBirth" type="date" class="form-control bg-dark text-white border-secondary" value="@Model.DateOfBirth.ToString("yyyy-MM-dd")">
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Gender" class="form-label text-light small fw-bold">GIỚI TÍNH</label>
                                    <select asp-for="Gender" class="form-select bg-dark text-white border-secondary">
                                        <option value="Nam">Nam</option>
                                        <option value="Nữ">Nữ</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="PhoneNumber" class="form-label text-light small fw-bold">SỐ ĐIỆN THOẠI</label>
                                    <input asp-for="PhoneNumber" class="form-control bg-dark text-white border-secondary">
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label text-light small fw-bold">EMAIL</label>
                                    <input asp-for="Email" type="email" class="form-control bg-dark text-white border-secondary">
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Address" class="form-label text-light small fw-bold">ĐỊA CHỈ</label>
                                    <input asp-for="Address" class="form-control bg-dark text-white border-secondary">
                                </div>
                            </div>

                            <h6 class="text-white border-bottom border-secondary pb-2 mb-3 mt-4">ĐỔI MẬT KHẨU (TÙY CHỌN)</h6>
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <label asp-for="NewPassword" class="form-label text-light small fw-bold">MẬT KHẨU MỚI</label>
                                    <input asp-for="NewPassword" type="password" class="form-control bg-dark text-white border-secondary" placeholder="Để trống nếu không đổi mật khẩu">
                                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ConfirmNewPassword" class="form-label text-light small fw-bold">NHẬP LẠI MẬT KHẨU MỚI</label>
                                    <input asp-for="ConfirmNewPassword" type="password" class="form-control bg-dark text-white border-secondary">
                                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end pt-3 border-top border-secondary">
                                <button type="submit" class="btn btn-brand rounded-pill px-4 fw-bold">
                                    <i class="bi bi-floppy-fill me-2"></i> Lưu thay đổi
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model GymWeb.Models.Member
@{
    ViewData["Title"] = "Thông tin cá nhân";
    var currentPackage = ViewBag.CurrentPackage as GymWeb.Models.MembershipPackage;
    var currentSubscription = ViewBag.CurrentSubscription as GymWeb.Models.Subscription;
    bool isActive = ViewBag.IsActive;
}

<section class="static-page-hero py-5">
    <div class="container text-center text-white py-4">
        <span class="section-eyebrow">Tài khoản của tôi</span>
        <h1 class="section-title mb-0">Xin chào, @Model.FullName</h1>
    </div>
</section>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <ul class="nav nav-pills mb-4 gap-2">
                <li class="nav-item"><a class="nav-link active" style="background-color:var(--brand-red);" asp-action="Index">Thông tin cá nhân</a></li>
                <li class="nav-item"><a class="nav-link text-dark" asp-action="Packages">Gói tập</a></li>
                <li class="nav-item"><a class="nav-link text-dark" asp-action="History">Lịch sử thanh toán</a></li>
                <li class="nav-item"><a class="nav-link text-dark" asp-action="Schedule">Lịch tập</a></li>
            </ul>

            <div class="row g-4">
                <div class="col-md-7">
                    <div class="static-page-card border p-4 p-md-5 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold mb-0">Hồ sơ hội viên</h5>
                            <a asp-action="Edit" class="btn btn-outline-brand btn-sm rounded-pill px-3">
                                <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                            </a>
                        </div>
                        <table class="table table-dark table-borderless mb-0 small">
                            <tbody>
                                <tr><td class="text-muted" style="width:40%;">Họ và tên</td><td class="fw-bold">@Model.FullName</td></tr>
                                <tr><td class="text-muted">Ngày sinh</td><td>@(Model.DateOfBirth == default ? "Chưa cập nhật" : Model.DateOfBirth.ToString("dd/MM/yyyy"))</td></tr>
                                <tr><td class="text-muted">Giới tính</td><td>@Model.Gender</td></tr>
                                <tr><td class="text-muted">Số điện thoại</td><td>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)</td></tr>
                                <tr><td class="text-muted">Email</td><td>@(string.IsNullOrEmpty(Model.Email) ? "Chưa cập nhật" : Model.Email)</td></tr>
                                <tr><td class="text-muted">Địa chỉ</td><td>@(string.IsNullOrEmpty(Model.Address) ? "Chưa cập nhật" : Model.Address)</td></tr>
                                <tr><td class="text-muted">Ngày tham gia</td><td>@Model.RegisterDate.ToString("dd/MM/yyyy")</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="static-page-card border p-4 p-md-5 h-100">
                        <h5 class="fw-bold mb-3">Gói tập hiện tại</h5>
                        @if (currentPackage != null && currentSubscription != null)
                        {
                            <h4 class="text-brand-red fw-bold mb-1">@currentPackage.PackageName</h4>
                            <p class="text-muted small mb-3">
                                Hiệu lực: @currentSubscription.StartDate.ToString("dd/MM/yyyy") - @currentSubscription.EndDate.ToString("dd/MM/yyyy")
                            </p>
                            @if (isActive)
                            {
                                <span class="badge bg-success mb-3">Đang sử dụng</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary mb-3">Đã hết hạn</span>
                            }
                            <div class="d-grid">
                                <a asp-action="Packages" class="btn btn-brand rounded-pill">
                                    @(isActive ? "Gia hạn thêm" : "Đăng ký lại")
                                </a>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small">Bạn chưa đăng ký gói tập nào.</p>
                            <div class="d-grid">
                                <a asp-action="Packages" class="btn btn-brand rounded-pill">Đăng ký ngay</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

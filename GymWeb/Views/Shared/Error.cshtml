@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<section class="static-page-hero py-5">
    <div class="container text-center text-white py-4">
        <span class="section-eyebrow">Gym Fitness</span>
        <h1 class="section-title mb-0"><i class="bi bi-exclamation-triangle-fill text-brand-red me-2"></i>Đã xảy ra lỗi</h1>
    </div>
</section>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="static-page-card border p-4 p-md-5 text-center">
                <p class="text-muted">Rất tiếc, đã có sự cố xảy ra trong quá trình xử lý yêu cầu của bạn.</p>

                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted">
                        <strong>Request ID:</strong> <code>@Model.RequestId</code>
                    </p>
                }

                <a asp-controller="Home" asp-action="Index" class="btn btn-brand rounded-pill px-4 mt-3">
                    <i class="bi bi-arrow-left me-1"></i> Quay về trang chủ
                </a>

                <hr class="my-4" />

                <div class="text-start small text-muted">
                    <p class="mb-1"><strong>Chế độ Development:</strong> chuyển sang môi trường <strong>Development</strong> để xem chi tiết lỗi.</p>
                    <p class="mb-0">Không nên bật môi trường Development cho ứng dụng đã triển khai vì có thể lộ thông tin nhạy cảm cho người dùng cuối. Để debug cục bộ, hãy đặt biến môi trường <strong>ASPNETCORE_ENVIRONMENT</strong> thành <strong>Development</strong> và khởi động lại ứng dụng.</p>
                </div>
            </div>
        </div>
    </div>
</div>

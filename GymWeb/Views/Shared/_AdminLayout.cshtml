<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ thống Quản trị GymFitness</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { background-color: var(--brand-black-soft); color: #ffffff; font-family: var(--font-body); }
        .sidebar { min-height: 100vh; background-color: var(--brand-black); border-right: 1px solid var(--brand-border); position: sticky; top: 0; }
        .sidebar-brand { font-family: var(--font-heading); letter-spacing: 1px; }
        .nav-link-admin { color: #9a9a9a; padding: 12px 22px; display: flex; align-items: center; text-decoration: none; font-weight: 600; font-size: 0.9rem; border-left: 3px solid transparent; }
        .nav-link-admin:hover { background-color: var(--brand-surface-2); color: #fff; }
        .nav-link-admin.active { background-color: rgba(227, 6, 19, 0.12); color: #fff; border-left-color: var(--brand-red); }
        .admin-card { background-color: var(--brand-surface); border: 1px solid var(--brand-border); border-radius: var(--radius-lg); }
        .admin-topbar { background-color: var(--brand-black-soft); border-bottom: 1px solid var(--brand-border); }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3 col-lg-2 px-0 sidebar">
                <div class="text-center py-4 border-bottom border-secondary">
                    <h4 class="text-brand-red fw-bold mb-0 sidebar-brand">GYMFITNESS</h4>
                    <small class="text-muted text-uppercase" style="letter-spacing: 1px;">Bảng điều khiển</small>
                </div>
                @{
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                    Func<string, string> navClass = c => "nav-link-admin" + (string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase) ? " active" : "");
                    var currentRole = Context.Session.GetString("Role") ?? "";
                    bool isAdminRole = currentRole == "Admin";
                }
                <div class="py-3">
                    @if (isAdminRole)
                    {
                        <a class="@navClass("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2 me-2"></i> Thống kê doanh thu
                        </a>
                        <a class="@navClass("Admin")" asp-controller="Admin" asp-action="Accounts">
                            <i class="bi bi-people-fill me-2"></i> Quản lý tài khoản
                        </a>
                    }
                    <a class="@navClass("Member")" asp-controller="Member" asp-action="Index">
                        <i class="bi bi-person-vcard-fill me-2"></i> Quản lý hội viên
                    </a>
                    @if (isAdminRole)
                    {
                        <a class="@navClass("Staff")" asp-controller="Staff" asp-action="Index">
                            <i class="bi bi-person-badge me-2"></i> Quản lý nhân viên
                        </a>
                        <a class="@navClass("Trainer")" asp-controller="Trainer" asp-action="Index">
                            <i class="bi bi-person-badge-fill me-2"></i> Quản lý huấn luyện viên
                        </a>
                        <a class="@navClass("Package")" asp-controller="Package" asp-action="Index">
                            <i class="bi bi-card-list me-2"></i> Quản lý gói tập
                        </a>
                        <a class="@navClass("Schedule")" asp-controller="Schedule" asp-action="Index">
                            <i class="bi bi-calendar2-week me-2"></i> Quản lý lịch tập
                        </a>
                    }
                    <a class="@navClass("Payment")" asp-controller="Payment" asp-action="Index">
                        <i class="bi bi-cash-stack me-2"></i> Quản lý thanh toán
                    </a>
                    <a class="@navClass("Subscription")" asp-controller="Subscription" asp-action="Index">
                        <i class="bi bi-journal-check me-2"></i> Đăng ký gói tập
                    </a>
                    @if (isAdminRole)
                    {
                        <a class="@navClass("Room")" asp-controller="Room" asp-action="Index">
                            <i class="bi bi-door-open-fill me-2"></i> Phòng tập
                        </a>
                    }
                    <div class="border-top border-secondary my-3"></div>
                    <a class="nav-link-admin text-muted" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-arrow-left-circle me-2"></i> Về trang chủ
                    </a>
                </div>
            </div>

            <div class="col-md-9 col-lg-10 p-0">
                <header class="admin-topbar d-flex justify-content-between align-items-center px-4 py-3 mb-4">
                    <div>
                        <h5 class="mb-0">@ViewData["Title"]</h5>
                        <small class="text-muted">Xin chào, <span class="text-white fw-semibold">@Context.Session.GetString("Username")</span></small>
                    </div>
                    <a class="btn btn-outline-brand btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Logout">
                        <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                    </a>
                </header>

                <partial name="_ToastNotifications" />

                <main role="main" class="px-4 pb-4">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <div class="modal fade app-confirm-modal" id="appConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-danger">
                <div class="modal-body text-center p-4">
                    <div class="confirm-icon mb-3"><i class="bi bi-question-circle"></i></div>
                    <h5 class="fw-bold mb-2" id="appConfirmTitle">Xác nhận thao tác</h5>
                    <p class="text-muted small mb-4" id="appConfirmMessage"></p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-outline-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-brand rounded-pill px-4" id="appConfirmOkBtn">Xác nhận</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

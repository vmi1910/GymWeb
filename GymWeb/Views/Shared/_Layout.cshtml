<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gym Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="topbar d-none d-md-block">
            <div class="container d-flex justify-content-between align-items-center py-2">
                <div>
                    <i class="bi bi-telephone-fill text-brand-red me-1"></i> Hotline: <a href="tel:1900xxxx" class="fw-semibold">1900 xxxx</a>
                    <span class="mx-3 text-secondary">|</span>
                    <i class="bi bi-geo-alt-fill text-brand-red me-1"></i> 526 Điện Biên Phủ, TP. Hồ Chí Minh
                </div>
                <div class="d-flex gap-2">
                    <a href="#" title="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" title="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" title="TikTok"><i class="bi bi-tiktok"></i></a>
                </div>
            </div>
        </div>

        @{
            var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
            Func<string, string, string> navActive = (controller, action) =>
                (currentController == controller && currentAction == action) ? "active" : "";
        }
        <nav class="navbar navbar-expand-lg navbar-dark navbar-brand-dark sticky-top py-3">
            <div class="container">
                <a class="navbar-brand text-brand-red fw-bold" asp-controller="Home" asp-action="Index">GYM FITNESS</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item"><a class="nav-link @navActive("Home", "Index")" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link @navActive("Home", "Programs")" asp-controller="Home" asp-action="Programs">Bộ môn tập luyện</a></li>
                        <li class="nav-item"><a class="nav-link @navActive("Home", "Facilities")" asp-controller="Home" asp-action="Facilities">Hệ thống phòng tập</a></li>
                        @if (Context.Session.GetString("Username") != null) {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-warning fw-bold" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i> @Context.Session.GetString("Username")
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end bg-dark border-secondary shadow" aria-labelledby="navbarDropdown">
                                    @if (Context.Session.GetString("Role") == "Admin") {
                                        <li>
                                            <a class="dropdown-item text-danger fw-bold" asp-controller="Admin" asp-action="Accounts">
                                                <i class="bi bi-speedometer2 me-2"></i> Quản trị hệ thống
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider border-secondary"></li>
                                    }
                                    @if (Context.Session.GetString("Role") == "Staff") {
                                        <li>
                                            <a class="dropdown-item text-warning fw-bold" asp-controller="Member" asp-action="Index">
                                                <i class="bi bi-speedometer2 me-2"></i> Khu vực làm việc
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider border-secondary"></li>
                                    }
                                    @if (Context.Session.GetString("Role") == "Member") {
                                        <li>
                                            <a class="dropdown-item text-white" asp-controller="Profile" asp-action="Index">
                                                <i class="bi bi-person-vcard me-2"></i> Thông tin cá nhân
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item text-white" asp-controller="Profile" asp-action="Packages">
                                                <i class="bi bi-card-list me-2"></i> Gói tập của tôi
                                            </a>
                                        </li>
                        <li>
                            <a class="dropdown-item text-white" asp-controller="RoomBooking" asp-action="Create">
                                <i class="bi bi-calendar2-plus me-2"></i> Đặt phòng tập
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item text-white" asp-controller="RoomBooking" asp-action="MyBookings">
                                <i class="bi bi-calendar-check me-2"></i> Lịch đặt phòng của tôi
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item text-white" asp-controller="Profile" asp-action="History">
                                                <i class="bi bi-receipt me-2"></i> Lịch sử thanh toán
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item text-white" asp-controller="Profile" asp-action="Schedule">
                                                <i class="bi bi-calendar2-week me-2"></i> Lịch tập
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider border-secondary"></li>
                                    <li>
                                        <a class="dropdown-item text-white" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        } else {
                            <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                                <a class="btn btn-brand btn-sm rounded-pill px-4" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <partial name="_ToastNotifications" />

    <main role="main">
        @RenderBody()
    </main>

    <div class="modal fade app-confirm-modal" id="appConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-danger">
                <div class="modal-body text-center p-4">
                    <div class="confirm-icon mb-3"><i class="bi bi-question-circle"></i></div>
                    <h5 class="fw-bold mb-2" id="appConfirmTitle">Xác nhận thao tác</h5>
                    <p class="text-muted small mb-4" id="appConfirmMessage"></p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-outline-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-brand rounded-pill px-4" id="appConfirmOkBtn">Xác nhận</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="site-footer text-white py-5 mt-auto">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <h5 class="fw-bold mb-3">GYM FITNESS</h5>
                    <p class="text-secondary mb-1">CÔNG TY CỔ PHẦN ĐẦU TƯ VÀ PHÁT TRIỂN GYM FITNESS</p>
                    <p class="text-secondary mb-1"><i class="bi bi-geo-alt-fill me-2 text-brand-red"></i>526 Điện Biên Phủ, Phường Thạnh Mỹ Tây, TP. Hồ Chí Minh</p>
                    <p class="text-secondary mb-1"><i class="bi bi-telephone-fill me-2 text-brand-red"></i>Hotline: 1900 xxxx</p>
                    <p class="text-secondary mb-0"><i class="bi bi-envelope-fill me-2 text-brand-red"></i>contact@gymfitness.com</p>
                </div>
                <div class="col-md-3">
                    <h5 class="fw-bold mb-3">Dịch vụ khách hàng</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#" class="text-decoration-none">Điều khoản sử dụng</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Chính sách bảo mật</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Programs" class="text-decoration-none">Bộ môn tập luyện</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Facilities" class="text-decoration-none">Hệ thống phòng tập</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5 class="fw-bold mb-3">Kết nối với chúng tôi</h5>
                    <div class="d-flex gap-2">
                        <a href="#" class="social-icon"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-tiktok"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
            </div>
            <hr class="border-secondary mt-4" />
            <div class="text-center text-secondary small">
                <p class="mb-0">&copy; 2026 Gym Management. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model IEnumerable<GymWeb.Models.Member>
@{
    ViewData["Title"] = "Quản lý hội viên";
    Layout = "_AdminLayout";
    var list = Model.ToList();
    bool isAdmin = Context.Session.GetString("Role") == "Admin";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["Success"]</div>
}

<div class="admin-card p-4 shadow">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-1">DANH SÁCH HỘI VIÊN</h3>
            <p class="text-muted small mb-0">Tổng số: @list.Count hội viên</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <form method="get" class="d-flex" style="max-width: 320px;">
                <input type="text" name="search" value="@ViewData["Search"]" class="form-control bg-dark text-white border-secondary me-2" placeholder="Tìm tên, SĐT, email...">
                <button type="submit" class="btn btn-outline-brand"><i class="bi bi-search"></i></button>
            </form>
            <a asp-action="Create" class="btn btn-brand fw-bold px-4 rounded-pill">
                <i class="bi bi-person-plus-fill me-2"></i> Thêm hội viên
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0" style="border-color: #222222;">
            <thead>
                <tr class="text-secondary small text-uppercase">
                    <th>Họ và tên</th>
                    <th>Giới tính</th>
                    <th>Số điện thoại</th>
                    <th>Email</th>
                    <th>Ngày đăng ký</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!list.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Không tìm thấy hội viên nào.</td></tr>
                }
                @foreach (var item in list)
                {
                    <tr>
                        <td class="fw-bold">@item.FullName</td>
                        <td>@item.Gender</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.Email</td>
                        <td>@item.RegisterDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.Status == "Active")
                            {
                                <span class="badge bg-success">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.Status</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.MemberID" class="btn btn-outline-info btn-sm me-2 rounded-pill px-3">
                                <i class="bi bi-search"></i> Tra cứu
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.MemberID" class="btn btn-outline-warning btn-sm me-2 rounded-pill px-3">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </a>
                            @if (isAdmin)
                            {
                                <form asp-action="Delete" asp-route-id="@item.MemberID" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                            onclick="return confirm('Xóa hội viên @item.FullName? Tài khoản đăng nhập liên kết cũng sẽ bị xóa.');">
                                        <i class="bi bi-trash3-fill"></i> Xóa
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

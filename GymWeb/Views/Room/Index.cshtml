@model IEnumerable<GymWeb.Models.Room>
@{
    ViewData["Title"] = "Quản lý phòng tập";
    Layout = "_AdminLayout";
    var list = Model.ToList();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 small">@TempData["Error"]</div>
}

<div class="admin-card p-4 shadow">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">DANH SÁCH PHÒNG TẬP</h3>
            <p class="text-muted small mb-0">Dữ liệu phòng dùng để xếp lịch làm việc nhân viên / huấn luyện viên</p>
        </div>
        <a asp-action="Create" class="btn btn-brand fw-bold px-4 rounded-pill">
            <i class="bi bi-plus-circle me-2"></i> Thêm phòng
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0" style="border-color: #222222;">
            <thead>
                <tr class="text-secondary small text-uppercase">
                    <th>Tên phòng</th>
                    <th>Tầng</th>
                    <th>Sức chứa</th>
                    <th>Tình trạng</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!list.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Chưa có phòng tập nào.</td></tr>
                }
                @foreach (var item in list)
                {
                    <tr>
                        <td class="fw-bold">@item.RoomName</td>
                        <td>Tầng @item.Floor</td>
                        <td>@item.Capacity người</td>
                        <td><span class="badge bg-info text-dark">@item.Status</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.RoomID" class="btn btn-outline-warning btn-sm me-2 rounded-pill px-3">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.RoomID" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                        onclick="return confirm('Xóa phòng @item.RoomName?');">
                                    <i class="bi bi-trash3-fill"></i> Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@model IEnumerable<GymWeb.Models.MembershipPackage>
@{
    ViewData["Title"] = "Quản lý gói tập";
    Layout = "_AdminLayout";
    var list = Model.ToList();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 small">@TempData["Error"]</div>
}

<div class="admin-card p-4 shadow">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">DANH SÁCH GÓI TẬP</h3>
            <p class="text-muted small mb-0">Quản lý các gói tập đang áp dụng tại phòng gym</p>
        </div>
        <a asp-action="Create" class="btn btn-brand fw-bold px-4 rounded-pill">
            <i class="bi bi-plus-circle me-2"></i> Thêm gói tập
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0" style="border-color: #222222;">
            <thead>
                <tr class="text-secondary small text-uppercase">
                    <th>Tên gói</th>
                    <th>Thời hạn</th>
                    <th>Giá</th>
                    <th>Mô tả</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!list.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Chưa có gói tập nào.</td></tr>
                }
                @foreach (var item in list)
                {
                    <tr>
                        <td class="fw-bold">@item.PackageName</td>
                        <td>@item.DurationDays ngày</td>
                        <td class="text-brand-red fw-bold">@item.Price.ToString("N0") đ</td>
                        <td class="small text-muted" style="max-width: 260px;">@item.Description</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Đang bán</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ngừng bán</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.PackageID" class="btn btn-outline-warning btn-sm me-2 rounded-pill px-3">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </a>
                            <form asp-action="ToggleStatus" asp-route-id="@item.PackageID" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-info btn-sm me-2 rounded-pill px-3">
                                    <i class="bi bi-arrow-repeat"></i> @(item.IsActive ? "Ngừng bán" : "Bán lại")
                                </button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@item.PackageID" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                        onclick="return confirm('Xóa gói tập @item.PackageName?');">
                                    <i class="bi bi-trash3-fill"></i> Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

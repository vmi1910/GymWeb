@model GymWeb.Models.MembershipPackage
@{
    ViewData["Title"] = "Thêm gói tập mới";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <div class="admin-card p-4 shadow mt-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="text-brand-red fw-bold mb-0">
                    <i class="bi bi-card-list me-2"></i> THÊM GÓI TẬP MỚI
                </h4>
                <a asp-action="Index" class="text-muted small text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                </a>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2">
                    <div asp-validation-summary="All" class="small mb-0"></div>
                </div>
            }

            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">TÊN GÓI TẬP *</label>
                    <input asp-for="PackageName" class="form-control bg-dark text-white border-secondary" required placeholder="VD: Gói 1 tháng, Gói 6 tháng...">
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">THỜI HẠN (SỐ NGÀY) *</label>
                        <input asp-for="DurationDays" type="number" min="1" class="form-control bg-dark text-white border-secondary" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">GIÁ (VNĐ) *</label>
                        <input asp-for="Price" type="number" min="0" step="1000" class="form-control bg-dark text-white border-secondary" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">MÔ TẢ QUYỀN LỢI</label>
                    <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Mô tả chi tiết quyền lợi hội viên nhận được"></textarea>
                </div>

                <div class="form-check form-switch mb-4">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive" checked>
                    <label class="form-check-label text-muted small">Kích hoạt bán ngay</label>
                </div>

                <div class="d-flex justify-content-end pt-3 border-top border-secondary">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 me-3">Hủy bỏ</a>
                    <button type="submit" class="btn btn-brand rounded-pill px-4 fw-bold">
                        <i class="bi bi-floppy-fill me-2"></i> Lưu gói tập
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@model GymWeb.ViewModels.PaymentCreateViewModel
@{
    ViewData["Title"] = "Lập hóa đơn thanh toán";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-7">
        <div class="admin-card p-4 shadow mt-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="text-brand-red fw-bold mb-0"><i class="bi bi-receipt-cutoff me-2"></i> LẬP HÓA ĐƠN THANH TOÁN</h4>
                <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2"><div asp-validation-summary="All" class="small mb-0"></div></div>
            }

            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">HỘI VIÊN *</label>
                    <select asp-for="MemberID" asp-items="ViewBag.MemberList" class="form-select bg-dark text-white border-secondary">
                        <option value="">-- Chọn hội viên --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">GÓI TẬP *</label>
                    <select asp-for="PackageID" asp-items="ViewBag.PackageList" class="form-select bg-dark text-white border-secondary">
                        <option value="">-- Chọn gói tập --</option>
                    </select>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">SỐ TIỀN THANH TOÁN</label>
                        <input asp-for="Amount" type="number" min="0" step="1000" class="form-control bg-dark text-white border-secondary" placeholder="Để trống = lấy giá gói tập">
                        <div class="form-text text-muted">Bỏ trống nếu thanh toán đủ 100% giá gói.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">PHƯƠNG THỨC</label>
                        <select asp-for="Method" class="form-select bg-dark text-white border-secondary">
                            <option value="Tiền mặt">Tiền mặt</option>
                            <option value="Chuyển khoản">Chuyển khoản</option>
                            <option value="Quẹt thẻ">Quẹt thẻ</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-end pt-3 border-top border-secondary">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 me-3">Hủy bỏ</a>
                    <button type="submit" class="btn btn-brand rounded-pill px-4 fw-bold"><i class="bi bi-floppy-fill me-2"></i> Lập hóa đơn</button>
                </div>
            </form>
        </div>
    </div>
</div>

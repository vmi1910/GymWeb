@{
    ViewData["Title"] = "Trang chủ";
}

<section class="position-relative d-flex align-items-center justify-content-center"
         style="min-height: 80vh; background: url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&amp;w=1470&amp;auto=format&amp;fit=crop') no-repeat center center/cover;">

    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(180deg, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.55) 60%, rgba(0,0,0,0.85) 100%);"></div>

    <div class="container position-relative text-center text-white mx-auto px-3" style="z-index: 2; max-width: 800px;">
        <span class="section-eyebrow d-inline-block mb-3">Hệ thống phòng tập đẳng cấp</span>
        <h1 class="fs-3 fs-md-1 fw-bold text-uppercase mb-3 text-nowrap">Trải nghiệm phòng tập <span class="text-brand-red">5 sao</span></h1>
        <p class="lead mb-4 fw-normal">Tặng ngay 1 tháng tập luyện miễn phí với hệ thống máy móc hiện đại nhất.</p>
        @if (Context.Session.GetString("Username") == null)
        {
            <a asp-controller="Account" asp-action="Register" class="btn btn-brand btn-lg px-5 py-3 rounded-pill shadow">Đăng ký nhận ưu đãi</a>
        }
        else
        {
            <a asp-controller="Home" asp-action="Facilities" class="btn btn-brand btn-lg px-5 py-3 rounded-pill shadow">Khám phá phòng tập</a>
        }
    </div>
</section>

<section class="stats-strip py-4 border-bottom border-dark">
    <div class="container">
        <div class="row g-4">
            <div class="col-6 col-md-3">
                <div class="stat-block">
                    <div class="stat-number">10+</div>
                    <div class="stat-label text-white-50">Chi nhánh</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-block">
                    <div class="stat-number">50K+</div>
                    <div class="stat-label text-white-50">Hội viên</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-block">
                    <div class="stat-number">100+</div>
                    <div class="stat-label text-white-50">Huấn luyện viên</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-block">
                    <div class="stat-number">8+</div>
                    <div class="stat-label text-white-50">Năm kinh nghiệm</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container mt-5 pt-5">
    <div class="text-center mb-5">
        <span class="section-eyebrow">Vì sao chọn chúng tôi</span>
        <h2 class="section-title">Cam kết chất lượng <span class="text-brand-red">hàng đầu</span></h2>
        <p class="section-subtitle">Đồng hành cùng bạn trên hành trình thay đổi vóc dáng với tiêu chuẩn dịch vụ chuyên nghiệp.</p>
    </div>

    <div class="row g-4 text-center">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="feature-icon"><i class="bi bi-cpu"></i></div>
            <h5 class="fw-bold">Trang thiết bị hiện đại</h5>
            <p class="text-muted small">Máy móc nhập khẩu Technogym, không gian tập luyện rộng rãi, thoáng mát.</p>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="feature-icon"><i class="bi bi-person-badge"></i></div>
            <h5 class="fw-bold">Huấn luyện viên chuyên nghiệp</h5>
            <p class="text-muted small">Đội ngũ PT giàu kinh nghiệm, đồng hành xây dựng lộ trình tập luyện riêng.</p>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="feature-icon"><i class="bi bi-calendar2-check"></i></div>
            <h5 class="fw-bold">Lịch tập linh hoạt</h5>
            <p class="text-muted small">Đa dạng khung giờ, lớp học nhóm và phòng tập cá nhân theo nhu cầu.</p>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="feature-icon"><i class="bi bi-shield-check"></i></div>
            <h5 class="fw-bold">Chính sách minh bạch</h5>
            <p class="text-muted small">Bảng giá rõ ràng, không phát sinh chi phí, hỗ trợ hội viên tận tâm.</p>
        </div>
    </div>
</section>

<section id="bomontap" class="container mt-5 pt-5">
    <div class="text-center mb-5">
        <span class="section-eyebrow">Bộ môn tập luyện</span>
        <h2 class="section-title">Trải nghiệm bộ môn <span class="text-brand-red">xu hướng</span></h2>
        <p class="section-subtitle">Tập luyện các bộ môn được hội viên yêu thích nhất cùng HLV chuyên nghiệp.</p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=500&amp;auto=format&amp;fit=crop" class="card-img-top course-img" alt="Yoga">
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold">YOGA</h5>
                    <p class="card-text small text-muted">Thân khỏe, tâm an cùng không gian Studio thiền tịnh cao cấp.</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1581009146145-b5ef050c2e1e?w=500&amp;auto=format&amp;fit=crop" class="card-img-top course-img" alt="Gym">
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold">GYM / CARDIO</h5>
                    <p class="card-text small text-muted">Tăng cơ, giảm mỡ hiệu quả với trang thiết bị máy móc Technogym.</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1518611012118-696072aa579a?w=500&amp;auto=format&amp;fit=crop" class="card-img-top course-img" alt="Zumba">
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold">DANCE &amp; ZUMBA</h5>
                    <p class="card-text small text-muted">Hòa mình vào âm nhạc sôi động, giải tỏa căng thẳng sau giờ làm.</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1549719386-74dfcbf7dbed?w=500&amp;auto=format&amp;fit=crop" class="card-img-top course-img" alt="Kick Fit">
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold">KICK FIT</h5>
                    <p class="card-text small text-muted">Rèn luyện cơ thể săn chắc, tăng phản xạ và khả năng tự vệ.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <a asp-controller="Home" asp-action="Programs" class="btn btn-outline-brand rounded-pill px-5">
            Xem tất cả bộ môn <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</section>

<section id="hethongphong" class="container mt-5 pt-5 mb-5">
    <div class="text-center mb-5">
        <span class="section-eyebrow">Chi nhánh</span>
        <h2 class="section-title">Hệ thống <span class="text-brand-red">Trung Tâm</span></h2>
        <p class="section-subtitle">Diện tích chuẩn cao cấp, không gian tập luyện thiết kế theo từng concept riêng biệt.</p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card bg-dark text-white border-0 branch-card position-relative">
                <img src="https://images.unsplash.com/photo-1571902943202-507ec2618e8f?w=600&amp;auto=format&amp;fit=crop" class="branch-img" alt="Quận 10">
                <div class="card-img-overlay d-flex flex-column justify-content-end p-4">
                    <h4 class="card-title fw-bold mb-1">CHI NHÁNH QUẬN 10</h4>
                    <p class="card-text small mb-3">Khu vườn nhiệt đới Fitness chuẩn 5 sao với diện tích hơn 3000 m2.</p>
                    <div><a asp-controller="Home" asp-action="Facilities" class="btn btn-outline-light btn-sm fw-bold">XEM THÊM &rarr;</a></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card bg-dark text-white border-0 branch-card position-relative">
                <img src="https://images.unsplash.com/photo-1593079831268-3381b0c13182?w=600&amp;auto=format&amp;fit=crop" class="branch-img" alt="Vạn Hạnh Mall">
                <div class="card-img-overlay d-flex flex-column justify-content-end p-4">
                    <h4 class="card-title fw-bold mb-1">VẠN HẠNH MALL</h4>
                    <p class="card-text small mb-3">Tiện lợi kết hợp mua sắm và tập luyện tại trung tâm thương mại lớn.</p>
                    <div><a asp-controller="Home" asp-action="Facilities" class="btn btn-outline-light btn-sm fw-bold">XEM THÊM &rarr;</a></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card bg-dark text-white border-0 branch-card position-relative">
                <img src="https://images.unsplash.com/photo-1574680096145-d05b474e2155?w=600&amp;auto=format&amp;fit=crop" class="branch-img" alt="Quận 4">
                <div class="card-img-overlay d-flex flex-column justify-content-end p-4">
                    <h4 class="card-title fw-bold mb-1">CHI NHÁNH QUẬN 4</h4>
                    <p class="card-text small mb-3">Sở hữu không gian thoáng đãng với hướng nhìn 2 mặt tiền sầm uất.</p>
                    <div><a asp-controller="Home" asp-action="Facilities" class="btn btn-outline-light btn-sm fw-bold">XEM THÊM &rarr;</a></div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <a asp-controller="Home" asp-action="Facilities" class="btn btn-outline-brand rounded-pill px-5">
            Xem tất cả phòng tập <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</section>

@if (Context.Session.GetString("Username") == null)
{
    <section class="container mb-5">
        <div class="cta-band text-white text-center p-5 shadow">
            <h3 class="fw-bold text-uppercase mb-2">Sẵn sàng bắt đầu hành trình của bạn?</h3>
            <p class="mb-4">Đăng ký ngay hôm nay để nhận buổi tập thử miễn phí cùng huấn luyện viên chuyên nghiệp.</p>
            <a asp-controller="Account" asp-action="Register" class="btn btn-dark btn-lg px-5 rounded-pill fw-bold">Đăng ký ngay</a>
        </div>
    </section>
}

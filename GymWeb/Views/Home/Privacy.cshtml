@{
    ViewData["Title"] = "Chính sách bảo mật";
}

<section class="static-page-hero py-5">
    <div class="container text-center text-white py-4">
        <span class="section-eyebrow">Gym Fitness</span>
        <h1 class="section-title mb-0">@ViewData["Title"]</h1>
    </div>
</section>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="static-page-card border p-4 p-md-5">
                <p class="text-muted mb-0">Nội dung chính sách bảo mật của Gym Fitness sẽ được cập nhật tại đây. Vui lòng liên hệ hotline hoặc email <strong>contact@gymfitness.com</strong> nếu bạn có bất kỳ thắc mắc nào về việc thu thập và sử dụng thông tin cá nhân.</p>
            </div>
        </div>
    </div>
</div>
